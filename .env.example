# Copy to .env for local development:  cp .env.example .env
#
# 1. docker compose up -d
# 2. npm install && npm run db:push && npm run db:seed
# 3. npm run dev

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vayasa"
SESSION_SECRET="your-long-random-secret-here"

# Paystack (https://dashboard.paystack.com) — ZAR
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"

# Ozow instant EFT (https://ozow.com) — optional
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_URL="https://pay.ozow.com"

# Capitec Pay — optional
CAPITEC_MERCHANT_ID=""
CAPITEC_API_KEY=""
CAPITEC_API_URL="https://pay.capitecbank.co.za"

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@vayasa.co.za"

# Twilio SMS (optional — OTP logged to console without these)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Resend email (optional — without key, verification links log to console)
RESEND_API_KEY=""
EMAIL_FROM="VayaSA <noreply@vayasa.co.za>"

# SA ID verification (VerifyID or similar)
VERIFYID_API_KEY=""

# Admin SOS alerts
ADMIN_ALERT_EMAIL="admin@vayasa.co.za"

# Production app URL (Paystack + email links)
NEXT_PUBLIC_APP_URL="https://www.vayasa.co.za"

# Analytics (optional) — your domain in Plausible, e.g. vayasa.co.za
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Persistent uploads — Cloudflare R2 or AWS S3 (recommended for production document storage)
# Without these, uploads fall back to local public/uploads (not persistent on Railway)
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_PUBLIC_URL="https://pub-xxx.r2.dev"

# Mobile app store links
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/vayasa"
NEXT_PUBLIC_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=co.za.vayasa"
