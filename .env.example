# Railway: add PostgreSQL, then set DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ridesa"
SESSION_SECRET="your-long-random-secret-here"

# PayFast (https://www.payfast.co.za)
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"

# Twilio SMS + WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Resend email
RESEND_API_KEY=""
EMAIL_FROM="RideSA <noreply@ridesa.co.za>"

# SA ID verification (VerifyID or similar)
VERIFYID_API_KEY=""

# Admin SOS alerts
ADMIN_ALERT_EMAIL="admin@ridesa.co.za"

# App URL (for PayFast callbacks)
NEXT_PUBLIC_APP_URL="https://ridesa-production.up.railway.app"

# Mobile app store links
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/ridesa"
NEXT_PUBLIC_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=co.za.ridesa"
