# Copy to .env for local development:  cp .env.example .env
#
# 1. docker compose up -d
# 2. npm install && npm run db:push && npm run db:seed
# 3. npm run dev

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ridesa"
SESSION_SECRET="your-long-random-secret-here"

# Paystack (https://dashboard.paystack.com) — ZAR, test keys for sandbox
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"

# Twilio SMS (optional — OTP codes logged to console in dev without these)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Resend email (optional)
RESEND_API_KEY=""
EMAIL_FROM="RideSA <noreply@ridesa.co.za>"

# SA ID verification (VerifyID or similar)
VERIFYID_API_KEY=""

# Admin SOS alerts
ADMIN_ALERT_EMAIL="admin@ridesa.co.za"

# App URL (Paystack callback + webhooks — use ngrok for local webhook testing)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mobile app store links
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/ridesa"
NEXT_PUBLIC_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=co.za.ridesa"
