generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  password                 String
  name                     String
  phone                    String?
  avatar                   String?
  bio                      String?
  rating                   Float    @default(5.0)
  tripCount                Int      @default(0)
  isAdmin                  Boolean  @default(false)
  isDriver                 Boolean  @default(false)
  driverVerificationStatus String   @default("none")
  defaultStartAction       String   @default("ride")
  emailVerified            Boolean  @default(false)
  phoneVerified            Boolean  @default(false)
  identityVerified         Boolean  @default(false)
  isSuspended              Boolean  @default(false)
  emergencyContact         String?
  emergencyContactName     String?
  bankAccountName          String?
  bankAccountNumber        String?
  bankName                 String?
  referralCode             String?  @unique
  referredById             String?
  createdAt                DateTime @default(now())

  rides              Ride[]
  bookings           Booking[]
  parcelBookings     ParcelBooking[]
  driverVerification DriverVerification?
  idVerification     IdVerification?
  reviewsGiven       Review[]            @relation("ReviewsGiven")
  reviewsReceived    Review[]            @relation("ReviewsReceived")
  reportsMade        Report[]            @relation("ReportsMade")
  reportsReceived    Report[]            @relation("ReportsReceived")
  messagesSent       Message[]
  disputes           Dispute[]
  emergencyAlerts    EmergencyAlert[]
  payments           Payment[]
  notifications      Notification[]
  payouts            Payout[]
  uploadedFiles      UploadedFile[]
  blocksMade         UserBlock[]         @relation("BlocksMade")
  blocksReceived     UserBlock[]         @relation("BlocksReceived")
  paymentIntents     PaymentIntent[]
}

model DriverVerification {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  idDocument          String?
  driverLicense       String?
  vehicleRegistration String?
  vehiclePhotos       String?
  selfiePhoto         String?
  vehicleModel        String?
  vehicleColor        String?
  vehicleYear         Int?
  status              String    @default("pending")
  rejectionReason     String?
  adminNotes          String?
  submittedAt         DateTime  @default(now())
  reviewedAt          DateTime?
}

model IdVerification {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  idNumber    String
  firstName   String?
  lastName    String?
  status      String    @default("pending")
  providerRef String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model City {
  id       String @id @default(cuid())
  name     String @unique
  province String
  slug     String @unique
}

model Ride {
  id                   String   @id @default(cuid())
  driverId             String
  driver               User     @relation(fields: [driverId], references: [id])
  originCity           String
  originSlug           String
  destinationCity      String
  destinationSlug      String
  departureDate        DateTime
  departureTime        String
  pricePerSeat         Int
  seatsTotal           Int
  seatsAvailable       Int
  description          String?
  carModel             String?
  carColor             String?
  smokingAllowed       Boolean  @default(false)
  petsAllowed          Boolean  @default(false)
  luggageSize          String   @default("medium")
  parcelSpaceTotal     Int      @default(0)
  parcelSpaceAvailable Int      @default(0)
  maxParcelWeight      Float?
  maxParcelSize        String?
  parcelPrice          Int      @default(0)
  pickupPoint          String?
  dropoffPoint         String?
  womenOnly            Boolean  @default(false)
  status               String   @default("active")
  tripStatus           String   @default("scheduled")
  shareToken           String   @unique @default(cuid())
  createdAt            DateTime @default(now())

  bookings       Booking[]
  parcelBookings ParcelBooking[]

  @@index([originSlug, destinationSlug, departureDate])
}

model Booking {
  id            String   @id @default(cuid())
  rideId        String
  ride          Ride     @relation(fields: [rideId], references: [id])
  passengerId   String
  passenger     User     @relation(fields: [passengerId], references: [id])
  seats         Int      @default(1)
  totalPrice    Int
  discountAmount Int     @default(0)
  promoCode     String?
  status        String   @default("pending")
  paymentStatus String   @default("unpaid")
  chatEnabled   Boolean  @default(false)
  reviewed      Boolean  @default(false)
  createdAt     DateTime @default(now())

  messages Message[]
  reviews  Review[]
  disputes Dispute[]

  @@unique([rideId, passengerId])
}

model ParcelBooking {
  id                    String   @id @default(cuid())
  rideId                String
  ride                  Ride     @relation(fields: [rideId], references: [id])
  senderId              String
  sender                User     @relation(fields: [senderId], references: [id])
  itemType              String
  itemSize              String
  itemWeight            Float
  pickupCity            String
  destinationCity       String
  pickupContactName     String
  pickupContactPhone    String
  receivingContactName  String
  receivingContactPhone String
  itemPhotos            String?
  pickupPoint           String?
  dropoffPoint          String?
  totalPrice            Int
  discountAmount        Int      @default(0)
  promoCode             String?
  status                String   @default("requested")
  paymentStatus         String   @default("unpaid")
  chatEnabled           Boolean  @default(false)
  proofOfDelivery       String?
  createdAt             DateTime @default(now())

  messages Message[]
  disputes Dispute[]
}

model Payment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  amount           Int
  method           String
  status           String   @default("pending")
  referenceType    String
  referenceId      String
  commissionAmount Int      @default(0)
  externalRef      String?
  createdAt        DateTime @default(now())

  @@index([referenceType, referenceId])
}

model PaymentIntent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amount        Int
  method        String
  referenceType String
  referenceId   String
  promoCode     String?
  status        String   @default("pending")
  externalRef   String?
  returnUrl     String?
  createdAt     DateTime @default(now())

  @@index([referenceType, referenceId])
}

model Message {
  id              String         @id @default(cuid())
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  parcelBookingId String?
  parcelBooking   ParcelBooking? @relation(fields: [parcelBookingId], references: [id])
  senderId        String
  sender          User           @relation(fields: [senderId], references: [id])
  content         String
  imageUrl        String?
  readAt          DateTime?
  createdAt       DateTime       @default(now())
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rideId     String?
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User     @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  rideId         String?
  reason         String
  description    String?
  status         String   @default("open")
  createdAt      DateTime @default(now())
}

model Dispute {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  parcelBookingId String?
  parcelBooking   ParcelBooking? @relation(fields: [parcelBookingId], references: [id])
  description     String
  status          String         @default("open")
  resolution      String?
  adminNotes      String?
  createdAt       DateTime       @default(now())
}

model EmergencyAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rideId    String?
  message   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id             String @id @default("default")
  commissionRate Float  @default(0.1)
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String
  subject   String?
  body      String
  status    String   @default("pending")
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Int
  maxUses       Int?
  usedCount     Int       @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Payout {
  id          String   @id @default(cuid())
  driverId    String
  driver      User     @relation(fields: [driverId], references: [id])
  amount      Int
  status      String   @default("pending")
  bankRef     String?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@index([driverId])
}

model UploadedFile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  filename  String
  mimeType  String
  url       String
  purpose   String
  createdAt DateTime @default(now())

  @@index([userId])
}
