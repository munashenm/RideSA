generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  password                 String
  name                     String
  phone                    String?
  avatar                   String?
  bio                      String?
  rating                   Float    @default(5.0)
  tripCount                Int      @default(0)
  isAdmin                  Boolean  @default(false)
  isDriver                 Boolean  @default(false)
  driverVerificationStatus String   @default("none")
  defaultStartAction       String   @default("ride")
  emailVerified            Boolean  @default(false)
  phoneVerified            Boolean  @default(false)
  identityVerified         Boolean  @default(false)
  isSuspended              Boolean  @default(false)
  createdAt                DateTime @default(now())

  rides              Ride[]
  bookings           Booking[]
  parcelBookings     ParcelBooking[]
  driverVerification DriverVerification?
  reviewsGiven       Review[]            @relation("ReviewsGiven")
  reviewsReceived    Review[]            @relation("ReviewsReceived")
  reportsMade        Report[]            @relation("ReportsMade")
  reportsReceived    Report[]            @relation("ReportsReceived")
  messagesSent       Message[]
  disputes           Dispute[]
  emergencyAlerts    EmergencyAlert[]
  payments           Payment[]
}

model DriverVerification {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  idDocument          String?
  driverLicense       String?
  vehicleRegistration String?
  vehiclePhotos       String?
  selfiePhoto         String?
  vehicleModel        String?
  vehicleColor        String?
  vehicleYear         Int?
  status              String    @default("pending")
  rejectionReason     String?
  adminNotes          String?
  submittedAt         DateTime  @default(now())
  reviewedAt          DateTime?
}

model City {
  id       String @id @default(cuid())
  name     String @unique
  province String
  slug     String @unique
}

model Ride {
  id                   String   @id @default(cuid())
  driverId             String
  driver               User     @relation(fields: [driverId], references: [id])
  originCity           String
  originSlug           String
  destinationCity      String
  destinationSlug      String
  departureDate        DateTime
  departureTime        String
  pricePerSeat         Int
  seatsTotal           Int
  seatsAvailable       Int
  description          String?
  carModel             String?
  carColor             String?
  smokingAllowed       Boolean  @default(false)
  petsAllowed          Boolean  @default(false)
  luggageSize          String   @default("medium")
  parcelSpaceTotal     Int      @default(0)
  parcelSpaceAvailable Int      @default(0)
  maxParcelWeight      Float?
  maxParcelSize        String?
  parcelPrice          Int      @default(0)
  pickupPoint          String?
  dropoffPoint         String?
  womenOnly            Boolean  @default(false)
  status               String   @default("active")
  tripStatus           String   @default("scheduled")
  shareToken           String   @unique @default(cuid())
  createdAt            DateTime @default(now())

  bookings       Booking[]
  parcelBookings ParcelBooking[]

  @@index([originSlug, destinationSlug, departureDate])
}

model Booking {
  id            String   @id @default(cuid())
  rideId        String
  ride          Ride     @relation(fields: [rideId], references: [id])
  passengerId   String
  passenger     User     @relation(fields: [passengerId], references: [id])
  seats         Int      @default(1)
  totalPrice    Int
  status        String   @default("pending")
  paymentStatus String   @default("unpaid")
  chatEnabled   Boolean  @default(false)
  reviewed      Boolean  @default(false)
  createdAt     DateTime @default(now())

  messages Message[]
  reviews  Review[]
  disputes Dispute[]

  @@unique([rideId, passengerId])
}

model ParcelBooking {
  id                    String   @id @default(cuid())
  rideId                String
  ride                  Ride     @relation(fields: [rideId], references: [id])
  senderId              String
  sender                User     @relation(fields: [senderId], references: [id])
  itemType              String
  itemSize              String
  itemWeight            Float
  pickupCity            String
  destinationCity       String
  pickupContactName     String
  pickupContactPhone    String
  receivingContactName  String
  receivingContactPhone String
  itemPhotos            String?
  pickupPoint           String?
  dropoffPoint          String?
  totalPrice            Int
  status                String   @default("requested")
  paymentStatus         String   @default("unpaid")
  chatEnabled           Boolean  @default(false)
  proofOfDelivery       String?
  createdAt             DateTime @default(now())

  messages Message[]
  disputes Dispute[]
}

model Payment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  amount           Int
  method           String
  status           String   @default("pending")
  referenceType    String
  referenceId      String
  commissionAmount Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([referenceType, referenceId])
}

model Message {
  id              String         @id @default(cuid())
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  parcelBookingId String?
  parcelBooking   ParcelBooking? @relation(fields: [parcelBookingId], references: [id])
  senderId        String
  sender          User           @relation(fields: [senderId], references: [id])
  content         String
  createdAt       DateTime       @default(now())
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rideId     String?
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User     @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  rideId         String?
  reason         String
  description    String?
  status         String   @default("open")
  createdAt      DateTime @default(now())
}

model Dispute {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  parcelBookingId String?
  parcelBooking   ParcelBooking? @relation(fields: [parcelBookingId], references: [id])
  description     String
  status          String         @default("open")
  resolution      String?
  adminNotes      String?
  createdAt       DateTime       @default(now())
}

model EmergencyAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rideId    String?
  message   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id             String @id @default("default")
  commissionRate Float  @default(0.1)
}
